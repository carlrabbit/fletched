<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Roslyn APIs for the generator pipeline benchmarks. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fletched.Core/Fletched.Core.csproj" />
    <!-- Regular (non-analyzer) reference so we can call the pipeline types directly. -->
    <ProjectReference Include="../../src/Fletched.Roslyn/Fletched.Roslyn.csproj" />
    <!-- Analyzer reference so benchmark predicate/fact declarations are source-generated. -->
    <ProjectReference Include="../../src/Fletched.Roslyn/Fletched.Roslyn.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
