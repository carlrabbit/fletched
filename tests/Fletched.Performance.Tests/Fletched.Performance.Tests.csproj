<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Roslyn APIs used in the pipeline compilation helper. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fletched.Core/Fletched.Core.csproj" />
    <ProjectReference Include="../../benchmarks/Fletched.Benchmarks/Fletched.Benchmarks.csproj" />
    <!-- Regular reference: exposes pipeline types (SemanticAnalyzer, IrLowerer, etc.) -->
    <ProjectReference Include="../../src/Fletched.Roslyn/Fletched.Roslyn.csproj" />
    <!-- Analyzer reference: runs the source generator so [Fact]/[Predicate] types get code-generated. -->
    <ProjectReference Include="../../src/Fletched.Roslyn/Fletched.Roslyn.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
