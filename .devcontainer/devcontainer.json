{
  "name": "fletched",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0-noble",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "NUGET_XMLDOC_MODE": "skip"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "Fletched.slnx",
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        }
      }
    }
  },
  "updateContentCommand": "dotnet restore Fletched.slnx && dotnet build Fletched.slnx -c Release --no-restore"
}
