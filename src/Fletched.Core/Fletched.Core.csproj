<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>Fletched.Core</PackageId>
    <Authors>Fletched Contributors</Authors>
    <Description>Typed runtime and DSL primitives for Fletched, a source-generated logic programming engine for .NET.</Description>
    <RepositoryUrl>https://github.com/carlrabbit/fletched</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/carlrabbit/fletched</PackageProjectUrl>
    <PackageTags>prolog;logic-programming;source-generator;roslyn;dotnet;dsl;query-engine</PackageTags>
    <PackageReadmeFile>Fletched.Core.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Performance types require System.Diagnostics.Metrics, available on net6.0+. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Performance/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <None Include="../../public-docs/nuget/Fletched.Core.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
