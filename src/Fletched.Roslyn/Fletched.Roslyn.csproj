<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <PackageId>Fletched.Roslyn</PackageId>
    <Authors>Fletched Contributors</Authors>
    <Description>Roslyn source generator and analyzers for Fletched typed logic predicates.</Description>
    <RepositoryUrl>https://github.com/carlrabbit/fletched</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/carlrabbit/fletched</PackageProjectUrl>
    <PackageTags>prolog;logic-programming;source-generator;roslyn;dotnet;dsl;query-engine</PackageTags>
    <PackageReadmeFile>Fletched.Roslyn.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);CS1570;CS1574;CS1587;CS8604;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference Core for its types (attributes etc.) visible to the generator -->
    <ProjectReference Include="../Fletched.Core/Fletched.Core.csproj" />
  </ItemGroup>
  <!-- Pack the analyzer assembly into the NuGet package. Uses None (not Analyzer) to avoid a
       circular self-reference where the compiler would try to load the not-yet-built DLL. -->
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../public-docs/nuget/Fletched.Roslyn.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
